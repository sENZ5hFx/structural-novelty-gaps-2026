{
  "name": "ppgc-frontend",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "npm run preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "validate": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": [
    "react",
    "react-dom"
  ],
  "devDependencies": [
    "vite",
    "@vitejs/plugin-react",
    "typescript",
    "@types/node@20",
    "@types/react",
    "@types/react-dom"
  ],
  "removed": [
    "next",
    "three",
    "@types/three",
    "tailwindcss",
    "autoprefixer",
    "postcss"
  ],
  "reason": "Client-only React SPA: eliminate unnecessary Next/Three/Tailwind dependencies and replace the broken container rewrite path with an explicit Vite API proxy."
}
